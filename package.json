{
  "name": "opencode-go-limits-sidebar",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "OpenCode plugin that shows OpenCode Go plan usage in the TUI sidebar (5h / weekly / monthly limits)",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "config": {
        "enabled": true
      }
    },
    "./tui": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.jsx",
      "config": {
        "enabled": true,
        "sidebar": true
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "dev": "opencode plugin dev",
    "test": "npm run build && vitest run"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.2.0"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "@opencode-ai/sdk": "^1.18.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.2",
    "vitest": "^4.1.2"
  }
}
